# ================================================
# Hermes Agent 환경변수 템플릿
# 실제 값은 ~/.hermes/.env 에만 저장하세요
# 이 파일은 키 이름만 공개용으로 제공합니다
# ================================================

# LLM / 임베딩
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# Hermes 대시보드 인증
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=your_username_here
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=your_password_here

# Discord (플랫폼 연동 시)
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Hermes 기본 설정 (값 수정 가능)
HERMES_UID=1000
HERMES_GID=1000
HERMES_WRITE_SAFE_ROOT=/opt/data:/mnt/d
HERMES_DASHBOARD=1
